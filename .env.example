# Copy this file to .env and fill in your real values.

# --- Anthropic Claude (required) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-4-7

# --- OpenAI DALL-E image generation (required) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Twitter/X (optional - leave blank to disable) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# --- LinkedIn ---
# From LinkedIn Developer Portal > Your App > Auth > Application credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Run: python linkedin_auth.py  to get the two values below
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_ID=
LINKEDIN_ORG_ID=            # numeric company page ID from linkedin.com/company/<ID>/
LINKEDIN_REFRESH_TOKEN=
# personal | organization | both
LINKEDIN_POST_AS=organization

# --- Reddit (optional - for trend reading only) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialMediaAgent/1.0

# --- Application settings ---
TIMEZONE=America/New_York
TECH_FOCUS=software development, AI/ML, cloud computing, Oracle Cloud Infrastructure (OCI), Oracle Database, Oracle APEX, DevOps, web development, cybersecurity
OUTPUT_DIR=./output
